    {
      "id": 6,
      "title": "MQTT Devices & Last Seen",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "mes_postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "mes_postgres"
          },
          "rawSql": "SELECT t.name AS \"Device\", t.\"deviceCode\" AS \"Code\", t.status AS \"Status\", t.\"lastSeenAt\" AS \"Last Seen\", t.\"lastError\" AS \"Last Error\" FROM devices t JOIN factories f ON f.id=t.\"factoryId\" WHERE ('$factory' = '' OR f.code = '$factory') AND UPPER(t.protocol)='MQTT' ORDER BY t.\"lastSeenAt\" DESC NULLS LAST LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
