            "type": "postgres",
            "uid": "mes_postgres"
          },
          "rawSql": "SELECT COALESCE(SUM(\"actualQty\"),0) AS value FROM shift_instances t JOIN factories f ON f.id = t.\"factoryId\" WHERE $__timeFilter(t.\"shiftDate\") AND ('$factory' = '' OR f.code = '$factory')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
