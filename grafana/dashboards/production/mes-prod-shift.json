    {
      "id": 6,
      "title": "Shift Detail",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "mes_postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "mes_postgres"
          },
          "rawSql": "SELECT s.name AS \"Shift\", t.\"shiftDate\" AS \"Date\", t.\"actualQty\" AS \"Actual\", t.\"targetQty\" AS \"Target\", t.\"goodQty\" AS \"Good\", t.\"scrapQty\" AS \"Scrap\", ROUND(t.oee::numeric,1) AS \"OEE %\" FROM shift_instances t JOIN factories f ON f.id=t.\"factoryId\" JOIN shift_templates s ON s.id=t.\"shiftTemplateId\" WHERE $__timeFilter(t.\"shiftDate\") AND ('$factory' = '' OR f.code = '$factory') ORDER BY t.\"shiftDate\" DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
