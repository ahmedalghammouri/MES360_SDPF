    {
      "id": 5,
      "title": "Shift Output vs Target",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "mes_postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "mes_postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(t.\"shiftDate\",$__interval), SUM(\"actualQty\") AS \"Actual\" FROM shift_instances t JOIN factories f ON f.id = t.\"factoryId\" WHERE $__timeFilter(t.\"shiftDate\") AND ('$factory' = '' OR f.code = '$factory') GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "mes_postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(t.\"shiftDate\",$__interval), SUM(\"targetQty\") AS \"Target\" FROM shift_instances t JOIN factories f ON f.id = t.\"factoryId\" WHERE $__timeFilter(t.\"shiftDate\") AND ('$factory' = '' OR f.code = '$factory') GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": "",
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
