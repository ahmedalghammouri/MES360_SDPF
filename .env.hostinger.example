# ============================================================
# MES360° — env for docker-compose.hostinger.yml (Traefik / Hostinger VPS)
# ------------------------------------------------------------
# On the VPS:
#   cp .env.hostinger.example .env.hostinger     # this real file is git-ignored
#   nano .env.hostinger                          # fill the CHANGE_ME values
#   docker compose -f docker-compose.hostinger.yml --env-file .env.hostinger up -d
#
# Generate a strong secret quickly:   openssl rand -base64 36
# Only the keys below are used by docker-compose.hostinger.yml.
# ============================================================

# --- Public domain (the ONE domain Traefik routes to this project) ---
# Must have a DNS A record pointing to the VPS IP. No https://, no slash.
APP_DOMAIN=mes360.industry360.sa

# --- Image source (CI pushes here) + tag ---
DOCKER_NS=gemyalghammouri678
TAG=latest

# --- Postgres ---
POSTGRES_DB=mes360
POSTGRES_USER=mes_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# --- InfluxDB (time-series) ---
INFLUX_USERNAME=admin
INFLUX_PASSWORD=CHANGE_ME_influx_admin_password
INFLUX_ORG=mes360
INFLUX_BUCKET=mes_timeseries
INFLUX_TOKEN=CHANGE_ME_long_random_influx_token

# --- MinIO (object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# --- JWT (each must be >= 32 chars) ---
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_characters_long
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_characters

# --- Grafana (embedded in the Dashboard Center, served under https://APP_DOMAIN/grafana) ---
# Datasource credentials are taken from POSTGRES_*/INFLUX_* above automatically.
# The API embed URLs (GRAFANA_URL / GRAFANA_PUBLIC_URL) are derived in the compose file.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password
