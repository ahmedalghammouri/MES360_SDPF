NODE_ENV=development

# Database
DATABASE_URL="postgresql://mes_user:mes_password@localhost:5433/star_mes"

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=star-mes-jwt-secret-key-min-32-characters-devv!
JWT_REFRESH_SECRET=star-mes-refresh-secret-key-min-32-chars-devv!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# InfluxDB — the code reads INFLUX_* (see config/configuration.ts + historian/influx.service.ts).
# Using INFLUXDB_* silently disables the historian → empty OEE/production trends.
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=star-mes-influxdb-token-dev
INFLUX_ORG=star-mes
INFLUX_BUCKET=mes_timeseries

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883

# App
API_PORT=4001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:4000,http://localhost:3000,http://127.0.0.1:4000,http://127.0.0.1:3000

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=mes-files

# ── Dashboard Center / Grafana integration ──────────────────────
# Server-side Grafana origin (used for HTTP API calls with the SA token)
GRAFANA_URL=http://localhost:3001
# Browser-facing base for iframe embedding (usually a reverse-proxied path that
# injects the Grafana auth.proxy header). Falls back to GRAFANA_URL if unset.
GRAFANA_PUBLIC_URL=/grafana
# Grafana service-account token (server→Grafana API; never exposed to browser)
GRAFANA_SA_TOKEN=
# Default Grafana org id
GRAFANA_DEFAULT_ORG_ID=1
# Grafana template variable name that carries factory context
GRAFANA_FACTORY_VAR=factory
